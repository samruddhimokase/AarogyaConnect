# Optional: only needed if you want the AI chat assistant to call the real
# Gemini API instead of falling back to its built-in rule-based reply.
#
# Vite only exposes variables prefixed with VITE_ to client code, so if you
# wire this in, read it in App.jsx via `import.meta.env.VITE_GEMINI_API_KEY`
# instead of the empty key currently in the fetch call.
#
# Never commit your real .env file — it's already in .gitignore.
VITE_GEMINI_API_KEY=

# Backend-only. Set this in the backend environment, never expose it to Vite.
MONGODB_URI=your_mongodb_atlas_connection_string
